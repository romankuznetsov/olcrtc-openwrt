#!/bin/sh
# Creates the interface, the firewall zone and the DNS wiring on first install.
#
# The interface is created DISABLED (auto '0'). Installing a package must never
# silently reroute someone's network -- enabling is an explicit act, from LuCI
# or with `uci set network.olcrtc.auto=1`.

. /lib/functions.sh

# ---------------------------------------------------------------- interface
if ! uci -q get network.olcrtc >/dev/null; then
	uci -q batch <<-UCI
		set network.olcrtc=interface
		set network.olcrtc.proto='olcrtc'
		set network.olcrtc.auto='0'
		set network.olcrtc.provider='jitsi'
		set network.olcrtc.room=''
		set network.olcrtc.transport='datachannel'
		set network.olcrtc.key_file='/etc/olcrtc/olcrtc.key'
		set network.olcrtc.socks_port='8808'
		set network.olcrtc.tun_addr='198.18.0.1'
		set network.olcrtc.mtu='8500'
		set network.olcrtc.dns_addr='127.0.0.1:5053'
		set network.olcrtc.block_quic='1'
		set network.olcrtc.block_ipv6='1'
		set network.olcrtc.default_route='1'
		set network.olcrtc.metric='10'
	UCI
	uci commit network
fi

# ------------------------------------------------------------------- zone
# A dedicated zone keeps the tunnel visible and editable in LuCI's Firewall
# page. family 'ipv4' is deliberate: the tunnel cannot carry IPv6, so the zone
# should never attract it.
if ! uci -q show firewall | grep -q "name='olcrtc'"; then
	z="$(uci add firewall zone)"
	uci -q batch <<-UCI
		set firewall.$z.name='olcrtc'
		set firewall.$z.family='ipv4'
		set firewall.$z.input='REJECT'
		set firewall.$z.output='ACCEPT'
		set firewall.$z.forward='REJECT'
		set firewall.$z.masq='1'
		set firewall.$z.mtu_fix='1'
		add_list firewall.$z.network='olcrtc'
	UCI
	f="$(uci add firewall forwarding)"
	uci -q batch <<-UCI
		set firewall.$f.src='lan'
		set firewall.$f.dest='olcrtc'
	UCI
	uci commit firewall
fi

# -------------------------------------------------------------------- DNS
# The tunnel cannot carry UDP, so plain DNS cannot traverse it. https-dns-proxy
# resolves over DoH on TCP/443, which rides the tunnel like any other TCP.
# DoH is preferred over DoT because TCP/443 is indistinguishable from ordinary
# HTTPS, whereas TCP/853 is a distinctive port.
if ! uci -q show https-dns-proxy | grep -q "listen_port='5053'"; then
	d="$(uci add https-dns-proxy https-dns-proxy)"
	uci -q batch <<-UCI
		set https-dns-proxy.$d.bootstrap_dns='1.1.1.1,1.0.0.1'
		set https-dns-proxy.$d.resolver_url='https://cloudflare-dns.com/dns-query'
		set https-dns-proxy.$d.listen_addr='127.0.0.1'
		set https-dns-proxy.$d.listen_port='5053'
	UCI
	uci commit https-dns-proxy
fi

exit 0
