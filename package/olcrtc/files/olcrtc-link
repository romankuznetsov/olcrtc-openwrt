#!/bin/sh
# olcrtc-link -- run olcRTC and hev-socks5-tunnel as a single supervised unit,
# and manage the leak-prevention firewall rules.
#
#   olcrtc-link <olcrtc.yaml> <hev.yaml> <ifname> <socks_port>
#   olcrtc-link --firewall-up <ifname> <block_quic> <block_ipv6> [fwmark] [icmp_mode]
#   olcrtc-link --firewall-down <ifname>
#
# In the first form this stays in the foreground so netifd's proto_run_command
# can supervise it. Two daemons, one supervision point: if either dies, this
# exits and netifd restarts the pair. That is what makes Stop in LuCI actually
# stop the tunnel rather than leaving a conference session open.

set -u

OLC_BIN=/usr/bin/olcrtc
HEV_BIN=/usr/bin/hev-socks5-tunnel
OLC_UID=olcrtc
PIDFILE=/var/run/olcrtc/olcrtc.pid
OLC_LOG=/var/log/olcrtc.log
NFT_FILE=/etc/nftables.d/90-olcrtc.nft

log() { logger -t olcrtc-link -p daemon.info -- "$*"; }
err() { logger -t olcrtc-link -p daemon.err  -- "$*"; echo "olcrtc-link: $*" >&2; }

# --------------------------------------------------------------- firewall
#
# The tunnel carries TCP over IPv4 only. A TUN device accepts everything the
# routing table sends it, so UDP, QUIC and IPv6 must be rejected explicitly --
# otherwise they do not merely fail, they silently take the clear WAN path
# while the interface looks up. Rejecting rather than dropping makes clients
# fail fast and fall back (browsers retry QUIC over TCP) instead of hanging.

firewall_up() {
	ifname="$1"; block_quic="$2"; block_ipv6="$3"; use_fwmark="${4:-0}"; icmp_mode="${5:-bypass}"

	mkdir -p /etc/nftables.d

	{
		echo "# generated by olcrtc-link -- do not edit"
		echo "chain olcrtc_fwd {"
		echo "    type filter hook forward priority filter + 10; policy accept;"
		# Every rule is scoped by oifname or iifname. An earlier version wrote
		# "meta nfproto ipv6 reject with icmpv6 ..." and nft folded the family
		# match into the reject statement, leaving a rule with NO match at all
		# -- an unconditional reject of every forwarded packet. Use icmpx (which
		# picks the right family itself) and always carry an explicit interface
		# match so a folded qualifier cannot widen the rule.
		echo "    oifname \"$ifname\" meta l4proto udp reject with icmpx type admin-prohibited comment \"olcrtc: tunnel cannot carry UDP\""
		if [ "$icmp_mode" = "reject" ]; then
			# ICMP cannot traverse a SOCKS5 CONNECT tunnel any more than UDP
			# can. Without this the packets reach the TUN and are silently
			# dropped, so ping just times out with no reason given. Rejecting
			# makes it fail in milliseconds with "administratively prohibited",
			# which is at least diagnosable.
			echo "    oifname \"$ifname\" meta l4proto icmp reject with icmpx type admin-prohibited comment \"olcrtc: tunnel cannot carry ICMP\""
		fi
		if [ "$block_quic" = 1 ]; then
			echo "    oifname \"$ifname\" udp dport 443 reject with icmpx type admin-prohibited comment \"olcrtc: QUIC blocked, forces TCP fallback\""
		fi
		if [ "$block_ipv6" = 1 ]; then
			# The IPv6 leak is the single most serious defect found in the
			# closest comparable project. Rejecting forwarded IPv6 from the LAN
			# while the tunnel is up is what stops it.
			echo "    meta nfproto ipv6 iifname \"br-lan\" reject with icmpx type admin-prohibited comment \"olcrtc: tunnel is IPv4-only\""
		fi
		echo "}"

		# The forward hook does not see traffic the router originates itself,
		# so `ping` from the router needs its own chain or it still hangs for
		# the full timeout.
		if [ "$icmp_mode" = "reject" ]; then
			echo "chain olcrtc_icmp_out {"
			echo "    type filter hook output priority filter + 10; policy accept;"
			echo "    oifname \"$ifname\" meta l4proto icmp reject with icmpx type admin-prohibited comment \"olcrtc: tunnel cannot carry ICMP\""
			echo "}"
		fi

		# Marking is a FALLBACK, only for kernels without 'ip rule uidrange'.
		#
		# It is emitted only when the uidrange rule could not be installed,
		# because it is not harmless alongside it: a "route" hook re-evaluates
		# routing after the mark is set, and that re-route loses the socket's
		# uid context. The uidrange rule then stops matching and olcRTC's own
		# traffic falls through to the catch-all -- into the tunnel it is
		# trying to build. Verified on hardware: with this chain present,
		# uid 8808 timed out; flushed, it correctly reached the WAN.
		if [ "$use_fwmark" = 1 ]; then
			echo "chain olcrtc_out {"
			echo "    type route hook output priority mangle; policy accept;"
			echo "    meta skuid \"$OLC_UID\" meta mark set 0x8808 comment \"olcrtc: own traffic bypasses the tunnel\""
			echo "}"
		fi
	} > "$NFT_FILE"

	_drop_chains
	reload_firewall
	log "firewall rules applied (quic=$block_quic ipv6=$block_ipv6 fwmark=$use_fwmark icmp=$icmp_mode)"
}

firewall_down() {
	rm -f "$NFT_FILE"
	_drop_chains
	reload_firewall
	log "firewall rules removed"
}

# Chains this script may create. fw4 reload rebuilds from /etc/nftables.d, but
# it does NOT remove a chain that an include previously defined and no longer
# does -- the orphan lingers in the live ruleset and keeps matching. Deleting
# them explicitly before each reload is what makes toggling an option (say
# icmp_reply) actually take effect rather than silently doing nothing.
OLC_CHAINS="olcrtc_fwd olcrtc_icmp_out olcrtc_out"

_drop_chains() {
	local c
	for c in $OLC_CHAINS; do
		nft delete chain inet fw4 "$c" 2>/dev/null
	done
}

reload_firewall() {
	if command -v fw4 >/dev/null 2>&1; then
		fw4 reload >/dev/null 2>&1 || err "fw4 reload failed"
	elif [ -x /etc/init.d/firewall ]; then
		/etc/init.d/firewall reload >/dev/null 2>&1 || err "firewall reload failed"
	fi
}

# ------------------------------------------------------- armed auto-revert
#
# A safety net for remote administration, in the spirit of "reload in 5" on
# network gear. Enabling default_route on a router you administer remotely can
# cut off your own management path; if that happens there is no way back in
# except physical access. With this armed, the interface tears itself down
# after N seconds unless somebody confirms the tunnel is healthy:
#
#     olcrtc-link --confirm      # cancels the pending revert
#
# Off by default (confirm_timeout=0), because on a locally-administered router
# it is only a way to lose a working tunnel.

CONFIRM_FLAG=/var/run/olcrtc/confirmed
REVERT_PID=/var/run/olcrtc/revert.pid

arm_revert() {
	secs="$1"; iface_cfg="$2"
	rm -f "$CONFIRM_FLAG"
	(
		sleep "$secs"
		if [ -f "$CONFIRM_FLAG" ]; then
			log "auto-revert cancelled (confirmed)"
		else
			err "auto-revert: not confirmed within ${secs}s -- taking $iface_cfg down"
			ifdown "$iface_cfg"
		fi
		rm -f "$REVERT_PID"
	) &
	echo $! > "$REVERT_PID"
	log "auto-revert armed: ${secs}s; run 'olcrtc-link --confirm' to keep it up"
}

disarm_revert() {
	[ -f "$REVERT_PID" ] || return 0
	kill "$(cat "$REVERT_PID")" 2>/dev/null
	rm -f "$REVERT_PID"
}

case "${1:-}" in
	--firewall-up)   shift; firewall_up   "$@"; exit $? ;;
	--firewall-down) shift; firewall_down "$@"; exit $? ;;
	--arm-revert)    shift; arm_revert    "$@"; exit $? ;;
	--disarm-revert) shift; disarm_revert "$@"; exit $? ;;
	--confirm)
		mkdir -p "$(dirname "$CONFIRM_FLAG")"
		: > "$CONFIRM_FLAG"
		disarm_revert
		echo "olcrtc: confirmed; auto-revert cancelled"
		exit 0 ;;
esac

# ----------------------------------------------------------------- run mode

OLC_CFG="${1:?usage: olcrtc-link <olcrtc.yaml> <hev.yaml> <ifname> <socks_port>}"
HEV_CFG="${2:?}"
IFNAME="${3:?}"
PORT="${4:?}"

[ -x "$OLC_BIN" ] || { err "$OLC_BIN not found"; exit 1; }
[ -x "$HEV_BIN" ] || { err "$HEV_BIN not found -- install hev-socks5-tunnel"; exit 1; }

mkdir -p "$(dirname "$PIDFILE")"

# Reap orphans from a previous run.
#
# A hard netifd restart (/etc/init.d/network restart) kills this supervisor
# without giving its EXIT trap a chance to run, leaving olcRTC still holding
# 127.0.0.1:<port> and hev-socks5-tunnel still holding the TUN. The replacement
# instance then dies immediately with "bind: address already in use", and netifd
# loops on it. Clearing them first makes bring-up idempotent.
_reap_orphans() {
	local p
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	if command -v pgrep >/dev/null 2>&1; then
		for p in $(pgrep -f "$OLC_BIN" 2>/dev/null) $(pgrep -f "$HEV_BIN" 2>/dev/null); do
			[ "$p" = "$$" ] && continue
			kill "$p" 2>/dev/null
		done
	else
		# busybox without pgrep: match on the exec path in /proc
		for p in /proc/[0-9]*; do
			case "$(tr '\000' ' ' < "$p/cmdline" 2>/dev/null)" in
				"$OLC_BIN "*|"$HEV_BIN "*) kill "${p#/proc/}" 2>/dev/null ;;
			esac
		done
	fi
	sleep 1
	ip link del "$IFNAME" 2>/dev/null
}
_reap_orphans

cleanup() {
	trap '' TERM INT EXIT
	[ -n "${HEV_PID:-}" ] && kill "$HEV_PID" 2>/dev/null
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	# hev-socks5-tunnel usually removes its TUN on exit; make sure, so a
	# restart does not trip over a leftover device.
	ip link del "$IFNAME" 2>/dev/null
	log "stopped"
}
trap cleanup TERM INT EXIT

# olcRTC runs as its own uid so `ip rule uidrange` can exempt its traffic.
# start-stop-daemon handles the uid switch and writes the pidfile; busybox
# provides it on every OpenWrt image.
log "starting olcrtc (socks 127.0.0.1:$PORT)"
# Run it through a shell that execs with output redirected to a log file.
# start-stop-daemon -b sends stdout and stderr to /dev/null, which makes every
# startup failure invisible -- the symptom is "olcrtc exited during startup"
# with no reason attached. Because the shell execs, the pidfile still holds
# olcrtc's own pid, so supervision is unaffected.
: > "$OLC_LOG" 2>/dev/null || true
chown "$OLC_UID" "$OLC_LOG" 2>/dev/null || true
if ! start-stop-daemon -S -b -m -p "$PIDFILE" -c "$OLC_UID"         -x /bin/sh -- -c "exec '$OLC_BIN' '$OLC_CFG' >>'$OLC_LOG' 2>&1"; then
	err "failed to start olcrtc"
	exit 1
fi
sleep 1
OLC_PID="$(cat "$PIDFILE" 2>/dev/null)"
[ -n "$OLC_PID" ] || { err "olcrtc pidfile empty"; exit 1; }

# Wait for the SOCKS5 listener before starting the bridge. hev-socks5-tunnel
# does not retry a refused upstream at startup, so racing it here produces a
# TUN that silently blackholes.
PORT_HEX="$(printf '%04X' "$PORT")"
i=0
while [ $i -lt 60 ]; do
	# Match the local_address column ending in our port AND state 0A
	# (TCP_LISTEN). A bare grep for the hex port would also match it
	# appearing as somebody else's remote port.
	if awk -v p=":$PORT_HEX" '$2 ~ p"$" && $4 == "0A" { found = 1 }
	                          END { exit !found }' /proc/net/tcp 2>/dev/null; then
		break
	fi
	if ! kill -0 "$OLC_PID" 2>/dev/null; then
		err "olcrtc exited during startup: $(tail -3 "$OLC_LOG" 2>/dev/null | tr '
' ' ')"
		exit 1
	fi
	sleep 1
	i=$((i + 1))
done
if [ $i -ge 60 ]; then
	err "olcrtc SOCKS5 listener did not come up within 60s"
	exit 1
fi
log "socks listener up after ${i}s"

log "starting hev-socks5-tunnel on $IFNAME"
"$HEV_BIN" "$HEV_CFG" &
HEV_PID=$!

# Supervise both. `wait -n` is not reliably available in busybox ash, so poll;
# a 2-second detection window is immaterial next to netifd's restart cycle.
while kill -0 "$OLC_PID" 2>/dev/null && kill -0 "$HEV_PID" 2>/dev/null; do
	sleep 2
done

kill -0 "$OLC_PID" 2>/dev/null || err "olcrtc exited: $(tail -3 "$OLC_LOG" 2>/dev/null | tr '
' ' ')"
kill -0 "$HEV_PID" 2>/dev/null || err "hev-socks5-tunnel exited"
exit 1
