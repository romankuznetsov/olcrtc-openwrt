#!/bin/sh
# olcrtc-link -- run olcRTC and hev-socks5-tunnel as a single supervised unit,
# and manage the leak-prevention firewall rules.
#
#   olcrtc-link <olcrtc.yaml> <hev.yaml> <ifname> <socks_port>
#   olcrtc-link --firewall-up <ifname> <block_quic> <block_ipv6>
#   olcrtc-link --firewall-down <ifname>
#
# In the first form this stays in the foreground so netifd's proto_run_command
# can supervise it. Two daemons, one supervision point: if either dies, this
# exits and netifd restarts the pair. That is what makes Stop in LuCI actually
# stop the tunnel rather than leaving a conference session open.

set -u

OLC_BIN=/usr/bin/olcrtc
HEV_BIN=/usr/bin/hev-socks5-tunnel
OLC_UID=olcrtc
PIDFILE=/var/run/olcrtc/olcrtc.pid
NFT_FILE=/etc/nftables.d/90-olcrtc.nft

log() { logger -t olcrtc-link -p daemon.info -- "$*"; }
err() { logger -t olcrtc-link -p daemon.err  -- "$*"; echo "olcrtc-link: $*" >&2; }

# --------------------------------------------------------------- firewall
#
# The tunnel carries TCP over IPv4 only. A TUN device accepts everything the
# routing table sends it, so UDP, QUIC and IPv6 must be rejected explicitly --
# otherwise they do not merely fail, they silently take the clear WAN path
# while the interface looks up. Rejecting rather than dropping makes clients
# fail fast and fall back (browsers retry QUIC over TCP) instead of hanging.

firewall_up() {
	ifname="$1"; block_quic="$2"; block_ipv6="$3"

	mkdir -p /etc/nftables.d

	{
		echo "# generated by olcrtc-link -- do not edit"
		echo "chain olcrtc_fwd {"
		echo "    type filter hook forward priority filter + 10; policy accept;"
		echo "    oifname \"$ifname\" meta l4proto udp reject with icmp type admin-prohibited comment \"olcrtc: tunnel cannot carry UDP\""
		if [ "$block_quic" = 1 ]; then
			echo "    meta nfproto ipv4 udp dport 443 reject with icmp type admin-prohibited comment \"olcrtc: QUIC blocked, forces TCP fallback\""
		fi
		if [ "$block_ipv6" = 1 ]; then
			# The IPv6 leak is the single most serious defect found in the
			# closest comparable project. Rejecting forwarded IPv6 while the
			# tunnel is up is what stops it.
			echo "    meta nfproto ipv6 reject with icmpv6 type admin-prohibited comment \"olcrtc: tunnel is IPv4-only\""
		fi
		echo "}"

		# Fallback marking for kernels without 'ip rule uidrange'. Harmless
		# when uidrange works, since that rule has the same preference and is
		# installed first.
		echo "chain olcrtc_out {"
		echo "    type route hook output priority mangle; policy accept;"
		echo "    meta skuid \"$OLC_UID\" meta mark set 0x8808 comment \"olcrtc: own traffic bypasses the tunnel\""
		echo "}"
	} > "$NFT_FILE"

	reload_firewall
	log "firewall rules applied (quic=$block_quic ipv6=$block_ipv6)"
}

firewall_down() {
	rm -f "$NFT_FILE"
	reload_firewall
	log "firewall rules removed"
}

reload_firewall() {
	if command -v fw4 >/dev/null 2>&1; then
		fw4 reload >/dev/null 2>&1 || err "fw4 reload failed"
	elif [ -x /etc/init.d/firewall ]; then
		/etc/init.d/firewall reload >/dev/null 2>&1 || err "firewall reload failed"
	fi
}

case "${1:-}" in
	--firewall-up)   shift; firewall_up   "$@"; exit $? ;;
	--firewall-down) shift; firewall_down "$@"; exit $? ;;
esac

# ----------------------------------------------------------------- run mode

OLC_CFG="${1:?usage: olcrtc-link <olcrtc.yaml> <hev.yaml> <ifname> <socks_port>}"
HEV_CFG="${2:?}"
IFNAME="${3:?}"
PORT="${4:?}"

[ -x "$OLC_BIN" ] || { err "$OLC_BIN not found"; exit 1; }
[ -x "$HEV_BIN" ] || { err "$HEV_BIN not found -- install hev-socks5-tunnel"; exit 1; }

mkdir -p "$(dirname "$PIDFILE")"

cleanup() {
	trap '' TERM INT EXIT
	[ -n "${HEV_PID:-}" ] && kill "$HEV_PID" 2>/dev/null
	if [ -f "$PIDFILE" ]; then
		kill "$(cat "$PIDFILE")" 2>/dev/null
		rm -f "$PIDFILE"
	fi
	# hev-socks5-tunnel usually removes its TUN on exit; make sure, so a
	# restart does not trip over a leftover device.
	ip link del "$IFNAME" 2>/dev/null
	log "stopped"
}
trap cleanup TERM INT EXIT

# olcRTC runs as its own uid so `ip rule uidrange` can exempt its traffic.
# start-stop-daemon handles the uid switch and writes the pidfile; busybox
# provides it on every OpenWrt image.
log "starting olcrtc (socks 127.0.0.1:$PORT)"
if ! start-stop-daemon -S -b -m -p "$PIDFILE" -c "$OLC_UID" -x "$OLC_BIN" -- "$OLC_CFG"; then
	err "failed to start olcrtc"
	exit 1
fi
sleep 1
OLC_PID="$(cat "$PIDFILE" 2>/dev/null)"
[ -n "$OLC_PID" ] || { err "olcrtc pidfile empty"; exit 1; }

# Wait for the SOCKS5 listener before starting the bridge. hev-socks5-tunnel
# does not retry a refused upstream at startup, so racing it here produces a
# TUN that silently blackholes.
PORT_HEX="$(printf '%04X' "$PORT")"
i=0
while [ $i -lt 60 ]; do
	# Match the local_address column ending in our port AND state 0A
	# (TCP_LISTEN). A bare grep for the hex port would also match it
	# appearing as somebody else's remote port.
	if awk -v p=":$PORT_HEX" '$2 ~ p"$" && $4 == "0A" { found = 1 }
	                          END { exit !found }' /proc/net/tcp 2>/dev/null; then
		break
	fi
	kill -0 "$OLC_PID" 2>/dev/null || { err "olcrtc exited during startup"; exit 1; }
	sleep 1
	i=$((i + 1))
done
if [ $i -ge 60 ]; then
	err "olcrtc SOCKS5 listener did not come up within 60s"
	exit 1
fi
log "socks listener up after ${i}s"

log "starting hev-socks5-tunnel on $IFNAME"
"$HEV_BIN" "$HEV_CFG" &
HEV_PID=$!

# Supervise both. `wait -n` is not reliably available in busybox ash, so poll;
# a 2-second detection window is immaterial next to netifd's restart cycle.
while kill -0 "$OLC_PID" 2>/dev/null && kill -0 "$HEV_PID" 2>/dev/null; do
	sleep 2
done

kill -0 "$OLC_PID" 2>/dev/null || err "olcrtc exited"
kill -0 "$HEV_PID" 2>/dev/null || err "hev-socks5-tunnel exited"
exit 1
